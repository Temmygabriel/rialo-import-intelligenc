# Import Intelligence MVP uses local reference data by default.
NEXT_PUBLIC_DEMO_MODE=true
# Rialo defaults to mock fallback unless real devnet probing is explicitly configured.
# Set RIALO_ADAPTER=real and RIALO_RPC_URL=http://devnet.rialo.io:4100 to enable the verified devnet reachability integration.
RIALO_ADAPTER=mock
RIALO_NETWORK=devnet
# RIALO_RPC_URL=http://devnet.rialo.io:4100
